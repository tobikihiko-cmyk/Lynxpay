APP_NAME=LynxPay
APP_VERSION=0.1.0
RELEASE_SHA=
ENVIRONMENT=development
PROCESS_TYPE=api
DEBUG=false

DATABASE_URL=postgresql://lynxpay_api:change-me@localhost:5432/lynxpay
# Production uses distinct NOSUPERUSER/NOBYPASSRLS identities. The worker,
# platform-admin, and metrics roles obtain only explicit cross-tenant policies.
WORKER_DATABASE_URL=
ADMIN_DATABASE_URL=
SECRET_KEY=generate-a-random-value-with-openssl-rand-hex-32
# Retained only to decrypt legacy enc:: values during rotation.
SECRET_ENCRYPTION_KEY=generate-a-separate-value-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
MFA_ISSUER=LynxPay

DASHBOARD_PUBLIC_URL=http://localhost:3000
EMAIL_DELIVERY_MODE=outbox
EMAIL_FROM=no-reply@lynxpay.local
EMAIL_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_FAIL_CLOSED=true

METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
# Use a read-only operational role that can aggregate across tenant RLS.
METRICS_DATABASE_URL=
OTEL_SERVICE_NAME=lynxpay
OTEL_EXPORTER_OTLP_ENDPOINT=

# Versioned envelope encryption. For production, prefer aws_kms and map key
# versions to merchant-independent KMS key ARNs/IDs. Keep old versions while
# any ciphertext still references them.
ENCRYPTION_PROVIDER=local
ENCRYPTION_ACTIVE_KEY_ID=v1
ENCRYPTION_KEYS_JSON={"v1":"generate-a-separate-random-master-key"}
ENCRYPTION_KMS_KEY_IDS_JSON=
AWS_REGION=af-south-1

PUBLIC_BASE_URL=https://pay.example.co.ke
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=127.0.0.1/32
TRUST_CF_CONNECTING_IP=false

MPESA_CALLBACK_VERIFY_MODE=ip_allowlist
MPESA_CALLBACK_IP_ALLOWLIST=196.201.214.200/29,196.201.214.208/29
MPESA_WEBHOOK_SECRET=
MAX_CALLBACK_BODY_BYTES=65536
RATE_LIMIT_CALLBACK_REQUESTS_PER_MINUTE=60
RATE_LIMIT_CALLBACK_VERIFIED_REQUESTS_PER_MINUTE=600
RATE_LIMIT_CALLBACK_UNVERIFIED_REQUESTS_PER_MINUTE=30

WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_CONNECT_TIMEOUT_SECONDS=5
WEBHOOK_TOTAL_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RESPONSE_BYTES=16384

RECONCILIATION_INITIAL_DELAY_SECONDS=120
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_MAX_ATTEMPTS=12
STK_SUBMITTING_TIMEOUT_SECONDS=120
REVERSAL_LEASE_SECONDS=60
MAINTENANCE_BATCH_SIZE=100
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
RETENTION_DELETION_ENABLED=false
CALLBACK_RETENTION_DAYS=400
WEBHOOK_DELIVERY_RETENTION_DAYS=180
STATUS_CHECK_RETENTION_DAYS=400
AUDIT_RETENTION_DAYS=2555
LEDGER_RETENTION_DAYS=2555

# Explicit, opt-in Safaricom sandbox contracts. The STK switch authorizes KES 1
# prompts to the dedicated test phone; never use merchant production secrets.
RUN_DARAJA_SANDBOX_TESTS=0
RUN_DARAJA_SANDBOX_STK_TESTS=0
DARAJA_SANDBOX_CONSUMER_KEY=
DARAJA_SANDBOX_CONSUMER_SECRET=
DARAJA_SANDBOX_PASSKEY=
DARAJA_SANDBOX_SHORTCODE=
DARAJA_SANDBOX_TILL_NUMBER=
DARAJA_SANDBOX_TEST_PHONE=
DARAJA_SANDBOX_CALLBACK_URL=
DARAJA_SANDBOX_CHECKOUT_REQUEST_ID=
